{
  "rewrites": [
    {
      "source": "/details/:id",
      "has": [{ "type": "query", "key": "_spa" }],
      "destination": "/index.html"
    },
    {
      "source": "/details/:id",
      "destination": "/api/og-details?id=:id"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
